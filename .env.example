# Copie este arquivo para .env e preencha os valores reais.
# NUNCA versione o arquivo .env (já está no .gitignore).

# brapi.dev — obter token gratuito em https://brapi.dev/dashboard
BRAPI_TOKEN=seu_token_aqui

# Banco de dados PostgreSQL (opcional, apenas para scripts locais)
# Exemplo: postgresql://usuario:senha@localhost:5432/mercado_financeiro
DATABASE_URL=

# Nível de log
LOG_LEVEL=INFO
